<?xml version="1.0" encoding="utf-8"?><Regulation lims:pit-date="2026-07-22" lims:lastAmendedDate="2026-07-22" lims:current-date="2026-09-03" lims:inforce-start-date="2026-07-22" lims:enacted-date="2026-07-22" lims:fid="1596957" lims:id="1596957" gazette-part="II" regulation-type="SI" xml:lang="en" xmlns:lims="http://justice.gc.ca/lims"><Identification lims:inforce-start-date="2026-07-22" lims:enacted-date="2026-07-22" lims:fid="1596958" lims:id="1596958"><InstrumentNumber>SI/2026-43</InstrumentNumber><RegistrationDate><Date><YYYY>2026</YYYY><MM>08</MM><DD>12</DD></Date></RegistrationDate><ConsolidationDate><Date><YYYY>2026</YYYY><MM>9</MM><DD>4</DD></Date></ConsolidationDate><EnablingAuthority lims:inforce-start-date="2026-07-22" lims:enacted-date="2026-07-22" lims:fid="1596959" lims:id="1596959"><XRefExternal reference-level="federal" reference-type="act" link="P-34">PUBLIC SERVICE REARRANGEMENT AND TRANSFER OF DUTIES ACT</XRefExternal></EnablingAuthority><LongTitle lims:inforce-start-date="2026-07-22" lims:enacted-date="2026-07-22" lims:fid="1596960" lims:id="1596960">Order Transferring from the Department of Natural Resources to the Department of the Environment the Control and Supervision of the Office of Energy Efficiency</LongTitle><RegulationMakerOrder><RegulationMaker>P.C.</RegulationMaker><OrderNumber>2026-723</OrderNumber><Date><YYYY>2026</YYYY><MM>07</MM><DD>22</DD></Date></RegulationMakerOrder></Identification><Order lims:inforce-start-date="2026-07-22" lims:enacted-date="2026-07-22" lims:fid="1596961" lims:id="1596961"><Provision lims:inforce-start-date="2026-07-22" lims:enacted-date="2026-07-22" lims:fid="1596962" lims:id="1596962" format-ref="indent-0-0" language-align="yes" list-item="no"><Text>Her Excellency the Governor General in Council, on the recommendation of the Prime Minister, under paragraph 2(a)<FootnoteRef idref="fn_81000-3-3078_hq_1778787386">a</FootnoteRef> of the <XRefExternal reference-level="federal" reference-type="act" link="P-34">Public Service Rearrangement and Transfer of Duties Act</XRefExternal><FootnoteRef idref="fn_81000-3-3078_hq_1778787406">b</FootnoteRef>, transfers from the Department of Natural Resources to the Department of the Environment the control and supervision of that portion of the federal public administration in the Department of Natural Resources known as the Office of Energy Efficiency, effective July 30, 2026.</Text><Footnote id="fn_81000-3-3078_hq_1778787386" placement="page" status="official"><Label>a</Label><Text>S.C. 2003, c. 22, s. 207</Text></Footnote><Footnote id="fn_81000-3-3078_hq_1778787406" placement="page" status="official"><Label>b</Label><Text>R.S., c. P-34</Text></Footnote></Provision></Order></Regulation>